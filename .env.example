# AI Provider Configuration:
# Choose "auto" (default: checks Gemini then Ollama), "ollama" (Local Offline AI), or "gemini" (Google Cloud AI)
AI_PROVIDER="auto"

# --- OLLAMA LOCAL AI CONFIGURATION ---
# Gunakan jika server menjalankan Ollama (100% offline, gratis tanpa internet)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
# Rekomendasi model: "qwen2.5:latest", "qwen2.5:7b", "llama3.2:latest", atau "gemma2:9b"
OLLAMA_MODEL="qwen2.5:latest"

# --- GEMINI CLOUD AI CONFIGURATION ---
# GEMINI_API_KEY: Diperlukan jika menggunakan Google AI Studio Cloud
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

